# ============================================
# DATA FILES (SENSITIVE - NEVER COMMIT)
# ============================================
data/raw/*.csv
data/raw/*.xlsx
data/raw/*.xls
data/processed/*.csv
data/processed/*.xlsx
data/processed/*.pkl

# Allow synthetic data (for testing)
!data/synthetic/*.csv

# ============================================
# PYTHON CACHE & COMPILED FILES
